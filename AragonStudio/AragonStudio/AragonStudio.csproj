<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

	<PropertyGroup>
		<TargetFramework>net8.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>
		<OutputType>Library</OutputType>
		<Platforms>x64</Platforms>
		<Nullable>enable</Nullable>
		<Title>Aragón Studio</Title>
	</PropertyGroup>

	<!-- Debug -->
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
		<PlatformTarget>x64</PlatformTarget>
		<OutputPath>bin\x64\Debug\</OutputPath>
	</PropertyGroup>

	<!-- Release -->
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
		<PlatformTarget>x64</PlatformTarget>
		<OutputPath>bin\x64\Release\</OutputPath>
	</PropertyGroup>

	<!-- 📦 Dependencias NuGet -->
	<ItemGroup>
		<PackageReference Include="SharpVectors.Wpf" Version="1.8.5" />
	</ItemGroup>

	<!-- 📘 Referencias de Revit 2025 -->
	<ItemGroup>
		<Reference Include="RevitAPI">
			<HintPath>C:\Program Files\Autodesk\Revit 2025\RevitAPI.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="RevitAPIUI">
			<HintPath>C:\Program Files\Autodesk\Revit 2025\RevitAPIUI.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>

	<!-- 📁 Recursos -->
	<ItemGroup>
		<Resource Include="Resources\Icons\Icons.xaml" />
		<Resource Include="Resources\Icons\Logo.ico" />
		<Resource Include="Resources\Icons\SvgIcons\Logo.ico">
		  <CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</Resource>
		<Content Include="Resources\Icons\SvgIcons\**\*.svg" CopyToOutputDirectory="Always" />
	</ItemGroup>
	<ItemGroup>
	  <None Remove="Resources\Icons\SvgIcons\Logo.ico" />
	</ItemGroup>
	<ItemGroup>
	  <Compile Update="Services\Guardado\RecordatorioService.cs">
	    <Generator>MSBuild:Compile</Generator>
	  </Compile>
	</ItemGroup>

	<!-- ⚙️ Asegura que SharpVectors se copie al output -->
	<Target Name="CopySharpVectorsAssemblies" AfterTargets="Build">
		<ItemGroup>
			<SharpVectorsAssemblies Include="$(NuGetPackageRoot)\sharpvectors.wpf\1.8.5\lib\net48\*.dll" />
		</ItemGroup>
		<Copy SourceFiles="@(SharpVectorsAssemblies)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
	</Target>

</Project>
