<Window x:Class="AragonStudio.UI.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ayuda"
        Height="350"
        Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="White">

    <Border CornerRadius="16" BorderBrush="#DDD" BorderThickness="1" Margin="20" Background="White" Padding="20">
        <Grid>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Height="252" >

                <!-- LOGO de Aragón Studio -->
                <Image Source="pack://application:,,,/AragonStudio;component/Resources/Icons/Logo.ico"
                       MaxWidth="120"
                       MaxHeight="120"
                       Margin="0,0,0,15"
                       HorizontalAlignment="Center"
                       Stretch="Uniform" Height="79" Width="57"/>

                <!-- Título -->
                <TextBlock Text="¿Necesitas ayuda?"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#222"
                           Margin="0,0,0,10"
                           TextAlignment="Center" />

                <!-- Mensaje explicativo -->
                <TextBlock Text="Contáctanos por WhatsApp y resolveremos tus dudas sobre Revit, BIM o nuestras herramientas digitales."
                           FontSize="14"
                           Foreground="#555"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,0,24"
                           MaxWidth="400"/>

                <!-- Botón principal -->
                <Button Content="Contactar por WhatsApp"
                        Width="240"
                        Height="44"
                        Background="#000000"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="14"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="Button_Click"
                        Padding="10,4"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
