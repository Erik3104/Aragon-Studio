<Window x:Class="AragonStudio.UI.Convertidor.DwgARvt.WaitForSpaceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ARAGÓN STUDIO"
        Width="450" Height="220"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True">
    <Border Background="#1A1A1A" CornerRadius="16" BorderBrush="#00D2FF" BorderThickness="2" Padding="20">
        <StackPanel>
            <TextBlock Text="VENTANAS CREADAS" FontSize="18" FontWeight="Bold" Foreground="white" HorizontalAlignment="Center" Height="20"/>
            <TextBlock Text="Para empotrarlas en los muros, pulse la tecla" Foreground="White" TextAlignment="Center" Margin="0,15,0,5"/>
            <TextBlock Text="ESPACIO" FontSize="28" FontWeight="Bold" Foreground="#00D2FF" HorizontalAlignment="Center" Margin="0,5,0,5"/>
            <TextBlock Text="(El cuadro se cerrará automáticamente)" Foreground="#888" FontSize="12" TextAlignment="Center"/>
            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,20,0,0" Foreground="#00D2FF" Background="#333"/>
        </StackPanel>
    </Border>
</Window>