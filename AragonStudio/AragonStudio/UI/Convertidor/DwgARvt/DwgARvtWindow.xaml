<Window x:Class="AragonStudio.UI.Convertidor.DwgARvt.DwgARvtWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DWG a Revit - Aragón Studio"
        Width="1150" Height="780"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#1E1E1E"
        FontFamily="Segoe UI">
    <Window.Icon>
        <BitmapImage UriSource="pack://application:,,,/AragonStudio;component/Resources/Icons/SvgIcons/Logo.ico"/>
    </Window.Icon>
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#3D3D3D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="1" Opacity="0.2" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#005A9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#3D3D3D"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#505050"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="IsEditable" Value="False"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#007ACC"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="ColorCellTemplate">
            <Border Width="20" Height="20" CornerRadius="3" Background="{Binding ColorBrush}" BorderBrush="#666" BorderThickness="1"/>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" 
                   Text="DWG → BIM" FontSize="20" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,15"/>

        <!-- Niveles -->
        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Padding="12" Margin="0,0,12,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Niveles" FontWeight="SemiBold" Foreground="#007ACC" Margin="0,0,20,0"/>
                <TextBlock Grid.Column="1" Text="Base:" Foreground="#CCCCCC"/>
                <ComboBox Grid.Column="2" Name="cmbLevelBase" Width="150" Margin="10,0,20,0" DisplayMemberPath="Name"/>
                <TextBlock Grid.Column="3" Text="Tope:" Foreground="#CCCCCC"/>
                <ComboBox Grid.Column="4" Name="cmbLevelTop" Width="150" DisplayMemberPath="Name"/>
            </Grid>
        </Border>

        <!-- Capas (con opción "Texto") -->
        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Card}" Padding="12" Margin="0,0,12,12">
            <StackPanel>
                <TextBlock Text="Capas detectadas" FontWeight="SemiBold" Foreground="#007ACC" Margin="0,0,0,10"/>
                <ListView Name="lvLayers" Background="White" BorderBrush="#3D3D3D" BorderThickness="1" Height="280">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Color" Width="40" CellTemplate="{StaticResource ColorCellTemplate}"/>
                            <GridViewColumn Header="Nombre" Width="130" DisplayMemberBinding="{Binding LayerName}"/>
                            <GridViewColumn Header="Cerradas" Width="55" DisplayMemberBinding="{Binding ClosedCount}"/>
                            <GridViewColumn Header="Abiertas" Width="55" DisplayMemberBinding="{Binding OpenCount}"/>
                            <GridViewColumn Header="Círculos" Width="55" DisplayMemberBinding="{Binding CircleCount}"/>
                            <GridViewColumn Header="Bloques" Width="55" DisplayMemberBinding="{Binding BlockCount}"/>
                            <GridViewColumn Header="Categoría BIM" Width="140">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding AvailableCategories}" SelectedItem="{Binding SelectedCategory}"
                                                  DisplayMemberPath="DisplayName"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Familia" Width="150">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding AvailableFamilies}" SelectedItem="{Binding SelectedFamily}"
                                                  DisplayMemberPath="Name" IsEnabled="{Binding IsFamilyEnabled}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </StackPanel>
        </Border>

        <!-- Parámetros (7 columnas) -->
        <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource Card}" Padding="12" Margin="0,0,12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Puerta (m)" Foreground="#CCCCCC" FontSize="11"/>
                    <TextBox Name="txtDoorHeight" Text="2.10" Background="#3D3D3D" Foreground="White" BorderBrush="#555" Height="28" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="Ventana (m)" Foreground="#CCCCCC" FontSize="11"/>
                    <TextBox Name="txtWindowHeight" Text="1.20" Background="#3D3D3D" Foreground="White" BorderBrush="#555" Height="28" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                    <TextBlock Text="Antepecho (m)" Foreground="#CCCCCC" FontSize="11"/>
                    <TextBox Name="txtSillHeight" Text="0.90" Background="#3D3D3D" Foreground="White" BorderBrush="#555" Height="28" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,8,0">
                    <TextBlock Text="Viga (m)" Foreground="#CCCCCC" FontSize="11"/>
                    <TextBox Name="txtBeamHeight" Text="0.30" Background="#3D3D3D" Foreground="White" BorderBrush="#555" Height="28" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="4" Margin="0,0,8,0">
                    <TextBlock Text="Desfase Viga (m)" Foreground="#CCCCCC" FontSize="11"/>
                    <TextBox Name="txtBeamOffset" Text="0.00" Background="#3D3D3D" Foreground="White" BorderBrush="#555" Height="28" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="5" Margin="0,0,8,0">
                    <TextBlock Text="Zapata (m)" Foreground="#CCCCCC" FontSize="11"/>
                    <TextBox Name="txtFootingThick" Text="0.30" Background="#3D3D3D" Foreground="White" BorderBrush="#555" Height="28" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="6">
                    <TextBlock Text="Suelo (m)" Foreground="#CCCCCC" FontSize="11"/>
                    <TextBox Name="txtFloorThick" Text="0.20" Background="#3D3D3D" Foreground="White" BorderBrush="#555" Height="28" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Vista previa -->
        <Border Grid.Row="1" Grid.Column="1" Grid.RowSpan="3" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Previsualización" FontWeight="SemiBold" Foreground="#007ACC" Margin="0,0,0,10"/>
                <Border Background="White" CornerRadius="6" Height="360" Margin="0,0,0,12" ClipToBounds="True">
                    <ScrollViewer Name="previewScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="White">
                        <Canvas x:Name="previewCanvas" Background="White" 
                                MouseWheel="PreviewCanvas_MouseWheel" 
                                MouseLeftButtonDown="PreviewCanvas_MouseLeftButtonDown"
                                MouseMove="PreviewCanvas_MouseMove"
                                MouseLeftButtonUp="PreviewCanvas_MouseLeftButtonUp">
                            <Canvas.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="previewScaleTransform" ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform x:Name="previewTranslateTransform" X="0" Y="0"/>
                                </TransformGroup>
                            </Canvas.RenderTransform>
                        </Canvas>
                    </ScrollViewer>
                </Border>
                <TextBlock Text="Estadísticas" Foreground="#007ACC" FontWeight="SemiBold" Margin="0,5,0,2"/>
                <TextBlock Name="txtStats" TextWrapping="Wrap" Foreground="#CCCCCC" FontSize="11" Margin="0,0,0,8"/>
                <Button Content="Refrescar vista" Style="{StaticResource SecondaryButton}" Height="28" Click="RefreshPreview_Click"/>
            </StackPanel>
        </Border>

        <!-- Botones -->
        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Name="btnGenerate" Content="GENERAR MODELO BIM" Style="{StaticResource PrimaryButton}" Width="200" Click="BtnGenerate_Click"/>
            <Button Name="btnCancel" Content="Cancelar" Style="{StaticResource SecondaryButton}" Width="90" Margin="10,0,0,0" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>