<Window x:Class="AragonStudio.UI.Vistas.FamiliaDeTipoAVista3D.FamiliaDeTipoAVista3DWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ARAGÓN STUDIO"
        Width="850" Height="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#1E1E1E"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.25" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ComboBoxOscuro" TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="ComboBoxItemClaro" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="#F0F0F0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E0E0E0"/>
                </Trigger>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#007ACC"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="12,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#005A9E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#555555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="8,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#505050"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="30"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="#007ACC"/>
            <Setter Property="Margin" Value="0,8"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Generar Vistas 3D por Tipo de Familia" FontWeight="Bold" FontSize="20" Foreground="White" Margin="0,0,0,10" TextAlignment="Center"/>

            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="10" Margin="0,4">
                <StackPanel>
                    <TextBlock Text="1. Categoría de elementos" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#E0E0E0"/>
                    <ComboBox x:Name="cmbCategorias" Style="{StaticResource ComboBoxOscuro}" SelectionChanged="cmbCategorias_SelectionChanged">
                        <ComboBox.Resources>
                            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource ComboBoxItemClaro}"/>
                        </ComboBox.Resources>
                    </ComboBox>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="10" Margin="0,4">
                <StackPanel>
                    <TextBlock Text="2. Parámetro de tipo (opcional, para el nombre de la vista)" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#E0E0E0"/>
                    <ComboBox x:Name="cmbParametro" Style="{StaticResource ComboBoxOscuro}" SelectionChanged="cmbParametro_SelectionChanged">
                        <ComboBox.Resources>
                            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource ComboBoxItemClaro}"/>
                        </ComboBox.Resources>
                    </ComboBox>
                    <TextBlock Text="(Si no se selecciona, se usará el nombre del tipo)" FontSize="11" Foreground="#AAAAAA" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="10" Margin="0,4">
                <StackPanel>
                    <TextBlock Text="3. Plantilla de vista 3D (opcional)" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#E0E0E0"/>
                    <ComboBox x:Name="cmbPlantillas" Style="{StaticResource ComboBoxOscuro}">
                        <ComboBox.Resources>
                            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource ComboBoxItemClaro}"/>
                        </ComboBox.Resources>
                    </ComboBox>
                    <TextBlock Text="(Dejar vacío para no aplicar plantilla)" FontSize="11" Foreground="#AAAAAA" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="4" Style="{StaticResource CardBorder}" Padding="10" Margin="0,4">
                <StackPanel>
                    <TextBlock Text="4. Tipos de familia utilizados en el modelo" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#E0E0E0"/>
                    <TextBox x:Name="txtFiltro" Tag="Filtrar tipos..." GotFocus="txtFiltro_GotFocus" LostFocus="txtFiltro_LostFocus"/>
                    <ListBox x:Name="lstTipos" Height="200" Margin="0,8">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected}" Margin="2"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4">
                        <Button Content="Seleccionar todos" Style="{StaticResource SecondaryButton}" Width="110" Margin="2" Click="SeleccionarTodos_Click"/>
                        <Button Content="Limpiar selección" Style="{StaticResource SecondaryButton}" Width="110" Margin="2" Click="LimpiarSeleccion_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <ProgressBar Grid.Row="5" x:Name="progressBar" Visibility="Collapsed"/>

            <Button Grid.Row="6" x:Name="btnGenerar" Content="Generar vistas 3D" Style="{StaticResource PrimaryButton}" Margin="0,10,0,4" Click="btnGenerar_Click" IsEnabled="False"/>

            <TextBlock Grid.Row="7" x:Name="txtResultado" Margin="0,6" TextWrapping="Wrap" FontSize="12" Foreground="#AAAAAA"/>

            <Button Grid.Row="8" x:Name="btnCerrar" Content="Cerrar" Style="{StaticResource SecondaryButton}" Width="100" HorizontalAlignment="Right" Click="btnCerrar_Click" Visibility="Collapsed" Margin="0,4,0,0"/>
        </Grid>
    </ScrollViewer>
</Window>