<Window x:Class="AragonStudio.UI.Gestión.ClasificacionPorTipo.EjecucionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ARAGÓN STUDIO - Paso 3 de 3"
        Width="650" Height="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1E1E1E"
        FontFamily="Segoe UI">
	<Window.Resources>
		<Style x:Key="CardBorder" TargetType="Border">
			<Setter Property="Background" Value="#2D2D2D"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Effect">
				<Setter.Value>
					<DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.25" Color="Black"/>
				</Setter.Value>
			</Setter>
		</Style>
		<Style x:Key="PrimaryButton" TargetType="Button">
			<Setter Property="Background" Value="#007ACC"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="Height" Value="38"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="12,6">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter Property="Background" Value="#005A9E"/>
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter Property="Background" Value="#555555"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<Style x:Key="SecondaryButton" TargetType="Button">
			<Setter Property="Background" Value="#3C3C3C"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="Height" Value="38"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="12,6">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter Property="Background" Value="#505050"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<Style TargetType="TextBlock">
			<Setter Property="Foreground" Value="#E0E0E0"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="TextWrapping" Value="Wrap"/>
		</Style>
		<Style TargetType="ProgressBar">
			<Setter Property="Height" Value="8"/>
			<Setter Property="Background" Value="#3C3C3C"/>
			<Setter Property="Foreground" Value="#007ACC"/>
		</Style>
	</Window.Resources>

	<Border Style="{StaticResource CardBorder}" Margin="15" Padding="20">
		<StackPanel>
			<TextBlock Text="Clasificación por orden constructivo" FontWeight="Bold" FontSize="20" Foreground="White" Margin="0,0,0,15" HorizontalAlignment="Center"/>

			<Border Background="#252525" CornerRadius="6" Padding="12" Margin="0,0,0,15">
				<StackPanel>
					<TextBlock Text="📋 Resumen de configuración" FontWeight="SemiBold" FontSize="14" Foreground="#DDDDDD" Margin="0,0,0,10"/>
					<TextBlock x:Name="txtResumenCategoria" Margin="0,2" Foreground="#AAAAAA"/>
					<TextBlock x:Name="txtResumenParametro" Margin="0,2" Foreground="#AAAAAA"/>
					<TextBlock x:Name="txtResumenPrefijo" Margin="0,2" Foreground="#AAAAAA"/>
					<TextBlock x:Name="txtResumenNiveles" Margin="0,2" Foreground="#AAAAAA"/>
					<TextBlock x:Name="txtResumenBase" Margin="0,2" Foreground="#AAAAAA"/>
				</StackPanel>
			</Border>

			<Button x:Name="btnEjecutar" Content="Ejecutar clasificación" Style="{StaticResource PrimaryButton}" Margin="0,5" Click="BtnEjecutar_Click"/>

			<ProgressBar x:Name="progressBar" Visibility="Collapsed" Margin="0,10,0,0"/>

			<TextBlock x:Name="txtResultado" Margin="0,15,0,0" TextWrapping="Wrap" FontSize="12" Foreground="#CCCCCC"/>

			<Button x:Name="btnCerrar" Content="Cerrar" Style="{StaticResource SecondaryButton}" Margin="0,15" Visibility="Collapsed" Click="BtnCerrar_Click" HorizontalAlignment="Center" Width="120"/>
		</StackPanel>
	</Border>
</Window>