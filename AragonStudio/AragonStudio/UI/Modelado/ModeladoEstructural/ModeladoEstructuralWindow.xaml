<Window x:Class="AragonStudio.UI.ModeladoEstructuralWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modelado Estructural"
        Height="400" Width="550"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow"
        Background="#FAFAFA">

    <Border CornerRadius="10"
            Background="White"
            Padding="20"
            Margin="15"
            BorderBrush="#DDDDDD"
            BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Título -->
                <RowDefinition Height="*"/>
                <!-- Descripción -->
                <RowDefinition Height="Auto"/>
                <!-- Botones -->
                <RowDefinition Height="Auto"/>
                <!-- Logo -->
            </Grid.RowDefinitions>

            <!-- Título -->
            <TextBlock Text="Modelado Estructural"
                       Grid.Row="0"
                       HorizontalAlignment="Center"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#222"
                       Margin="0,0,0,15"/>

            <!-- Descripción -->
            <TextBlock Text="Facilita la creación y gestión de elementos estructurales como vigas, columnas y fundaciones en Revit."
                       Grid.Row="1"
                       FontSize="14"
                       Foreground="#555"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="10,0,10,10"/>

            <!-- Botones -->
            <StackPanel Grid.Row="2"
                        Orientation="Vertical"
                        HorizontalAlignment="Center"
                        Margin="0,10,0,10">

                <Button Content="Iniciar Modelado"
                        Width="200" Height="40"
                        FontSize="14"
                        Margin="0,0,0,10"
                        Click="Iniciar_Click"/>

                <Button Content="Cerrar"
                        Width="200" Height="40"
                        FontSize="14"
                        Click="Cerrar_Click"/>
            </StackPanel>

            <!-- Logo -->
            <Image Grid.Row="3"
                   Source="pack://application:,,,/AragonStudio;component/Resources/Icons/Logo.ico"
                   Width="64" Height="64"
                   HorizontalAlignment="Center"
                   Margin="0,20,0,0"/>
        </Grid>
    </Border>
</Window>
