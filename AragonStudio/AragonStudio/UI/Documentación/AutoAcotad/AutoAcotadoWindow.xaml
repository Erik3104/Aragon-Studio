<Window x:Class="AragonStudio.UI.AutoAcotado.AutoAcotadoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aragón Studio | Auto Acotado"
        Height="650"
        Width="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">

    <!-- Marco negro -->
    <Border BorderBrush="Black"
            BorderThickness="2"
            CornerRadius="6"
            Padding="10">

        <ScrollViewer VerticalScrollBarVisibility="Auto">

            <StackPanel>

                <!-- LOGO -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,5,0,15">
                    <Image Source="/AragonStudio;component/Resources/Icons/Logo/AragonStudio.png"
                           Height="40"
                           Margin="0,0,10,0"/>
                    <TextBlock Text="AUTO ACOTADO"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- ========================= -->
                <!-- VISTAS -->
                <!-- ========================= -->
                <TextBlock Text="Vistas a acotar"
                           Foreground="#CCCCCC"
                           FontWeight="SemiBold"
                           Margin="5,5"/>

                <Border Background="#2A2A2A"
                        CornerRadius="4"
                        Padding="6"
                        Margin="0,0,0,15">

                    <TreeView x:Name="treeVistas"
                              Background="#2A2A2A"
                              Foreground="White"
                              BorderThickness="0"/>
                </Border>

                <!-- ========================= -->
                <!-- ELEMENTOS -->
                <!-- ========================= -->
                <TextBlock Text="Elementos a acotar"
                           Foreground="#CCCCCC"
                           FontWeight="SemiBold"
                           Margin="5,5"/>

                <Border Background="#2A2A2A"
                        CornerRadius="4"
                        Padding="8"
                        Margin="0,0,0,15">

                    <StackPanel>
                        <CheckBox Content="Ejes" Foreground="White"/>
                        <CheckBox Content="Límites del proyecto / lote" Foreground="White"/>
                        <CheckBox Content="Muros" Foreground="White"/>
                        <CheckBox Content="Puertas" Foreground="White"/>
                        <CheckBox Content="Ventanas" Foreground="White"/>
                        <CheckBox Content="Espacios internos" Foreground="White"/>
                    </StackPanel>
                </Border>

                <!-- ========================= -->
                <!-- TIPO DE COTA -->
                <!-- ========================= -->
                <TextBlock Text="Tipo de cota"
                           Foreground="#CCCCCC"
                           FontWeight="SemiBold"
                           Margin="5,5"/>

                <Border Background="#2A2A2A"
                        CornerRadius="4"
                        Padding="6"
                        Margin="0,0,0,20">

                    <ComboBox x:Name="cmbTiposCota"
                              Background="#3A3A3A"
                              Foreground="White"
                              BorderBrush="#555555"/>
                </Border>

                <!-- ========================= -->
                <!-- BOTONES -->
                <!-- ========================= -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button Content="Cancelar"
                            Width="90"
                            Margin="0,0,10,0"
                            Background="#3A3A3A"
                            Foreground="White"/>

                    <Button Content="Ejecutar"
                            Width="110"
                            Background="#007ACC"
                            Foreground="White"
                            FontWeight="Bold"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
