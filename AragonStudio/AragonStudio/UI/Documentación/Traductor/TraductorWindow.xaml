<Window x:Class="AragonStudio.UI.TraductorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Traductor de Texto"
        Height="380" Width="560"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow"
        Background="#FAFAFA">

    <Border CornerRadius="10"
            Background="White"
            Padding="20"
            Margin="15"
            BorderBrush="#DDDDDD"
            BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Título -->
                <RowDefinition Height="*"/>
                <!-- Cuerpo -->
                <RowDefinition Height="Auto"/>
                <!-- Botones -->
                <RowDefinition Height="Auto"/>
                <!-- Logo -->
            </Grid.RowDefinitions>

            <!-- Título -->
            <TextBlock Text="Herramienta de Traducción"
                       Grid.Row="0"
                       HorizontalAlignment="Center"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#222"
                       Margin="0,0,0,15"/>

            <!-- Contenido -->
            <StackPanel Grid.Row="1" Margin="10">
                <TextBlock Text="Texto a traducir:" 
                           FontWeight="SemiBold" 
                           Margin="0,0,0,5" 
                           Foreground="#333"/>
                <TextBox x:Name="InputText"
                         Height="80"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         FontSize="14"
                         VerticalScrollBarVisibility="Auto"
                         BorderBrush="#CCCCCC"
                         BorderThickness="1"
                         Padding="8"/>

                <TextBlock Text="Resultado:" 
                           FontWeight="SemiBold" 
                           Margin="0,15,0,5" 
                           Foreground="#333"/>
                <TextBox x:Name="OutputText"
                         Height="80"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         FontSize="14"
                         IsReadOnly="True"
                         Background="#F5F5F5"
                         BorderBrush="#CCCCCC"
                         BorderThickness="1"
                         Padding="8"/>
            </StackPanel>

            <!-- Botones -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,10,0,10">

                <Button Content="Traducir"
                        Width="120" Height="40"
                        FontSize="14"
                        Margin="0,0,10,0"
                        Click="Traducir_Click"/>

                <Button Content="Limpiar"
                        Width="120" Height="40"
                        FontSize="14"
                        Margin="0,0,10,0"
                        Click="Limpiar_Click"/>

                <Button Content="Cerrar"
                        Width="120" Height="40"
                        FontSize="14"
                        Click="Cerrar_Click"/>
            </StackPanel>

            <!-- Logo -->
            <Image Grid.Row="3"
                   Source="pack://application:,,,/AragonStudio;component/Resources/Icons/Logo.ico"
                   Width="64" Height="64"
                   HorizontalAlignment="Center"
                   Margin="0,20,0,0"/>
        </Grid>
    </Border>
</Window>
