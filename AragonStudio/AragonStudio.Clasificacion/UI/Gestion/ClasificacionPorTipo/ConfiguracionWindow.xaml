<Window x:Class="AragonStudio.UI.Gestión.ClasificacionPorTipo.ConfiguracionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ARAGÓN STUDIO - Paso 1 de 3"
        Width="850" Height="650"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#1E1E1E"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.25" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ComboBoxOscuro" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="ComboBoxItemClaro" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="#F0F0F0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E0E0E0"/>
                </Trigger>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#007ACC"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="12,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#005A9E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#555555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="8,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#505050"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="32"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Clasificación por Orden Constructivo" FontWeight="Bold" FontSize="20" Foreground="White" Margin="0,0,0,15"/>

            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="12" Margin="0,5">
                <StackPanel>
                    <TextBlock Text="1. Categoría de elementos" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#E0E0E0"/>
                    <ComboBox x:Name="cmbCategorias" Style="{StaticResource ComboBoxOscuro}" SelectionChanged="CmbCategorias_SelectionChanged">
                        <ComboBox.Resources>
                            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource ComboBoxItemClaro}"/>
                        </ComboBox.Resources>
                    </ComboBox>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="12" Margin="0,5">
                <StackPanel>
                    <TextBlock Text="2. Parámetro de tipo donde guardar la clasificación" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#E0E0E0"/>
                    <ComboBox x:Name="cmbParametro" Style="{StaticResource ComboBoxOscuro}">
                        <ComboBox.Resources>
                            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource ComboBoxItemClaro}"/>
                        </ComboBox.Resources>
                    </ComboBox>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="12" Margin="0,5">
                <StackPanel>
                    <TextBlock Text="3. Prefijo para los códigos (ej. P, V, M)" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#E0E0E0"/>
                    <TextBox x:Name="txtPrefijo" Text="P"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="4" Style="{StaticResource CardBorder}" Padding="12" Margin="0,5">
                <StackPanel>
                    <TextBlock Text="4. Seleccionar y ordenar niveles (orden constructivo)" FontWeight="SemiBold" Margin="0,0,0,12" Foreground="#E0E0E0"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Niveles disponibles" Margin="5,0,0,8" Foreground="#AAAAAA"/>
                            <ListBox x:Name="lstDisponibles" Height="180" SelectionMode="Extended"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10">
                            <Button Content="→" Style="{StaticResource SecondaryButton}" Width="45" Height="45" Margin="5" Click="AgregarNiveles_Click" FontSize="18" FontWeight="Bold"/>
                            <Button Content="←" Style="{StaticResource SecondaryButton}" Width="45" Height="45" Margin="5" Click="QuitarNiveles_Click" FontSize="18" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Niveles seleccionados (orden de construcción)" Margin="5,0,0,8" Foreground="#AAAAAA"/>
                            <ListBox x:Name="lstSeleccionados" Height="150" SelectionMode="Extended"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8">
                                <Button Content="Subir ↑" Style="{StaticResource SecondaryButton}" Width="70" Margin="2" Click="SubirNivel_Click"/>
                                <Button Content="Bajar ↓" Style="{StaticResource SecondaryButton}" Width="70" Margin="2" Click="BajarNivel_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Button Grid.Row="5" x:Name="btnSiguiente" Content="Siguiente →" Style="{StaticResource PrimaryButton}" Width="140" HorizontalAlignment="Right" Margin="0,20" Click="BtnSiguiente_Click" IsEnabled="False"/>
        </Grid>
    </ScrollViewer>
</Window>