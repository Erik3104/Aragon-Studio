<Window x:Class="AragonStudio.UI.VisibilityManager.VisibilityManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:AragonStudio.Models.VisibilityManager"
        Title="ARAGÓN STUDIO" 
        Height="620" Width="900" 
        MinHeight="500" MinWidth="780"
        Background="#111111" FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#005A9E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="2"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="TreeView">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#404040"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="160"/>
            <Setter Property="MaxHeight" Value="200"/>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="#3D3D3D"/>
            <Setter Property="Foreground" Value="#007ACC"/>
            <Setter Property="Height" Value="8"/>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="BorderBrush" Value="#2D2D2D"/>
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#111111" Offset="0"/>
                <GradientStop Color="#1B1B1B" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="GESTOR DE VISIBILIDAD BIM" 
                           FontSize="22" FontWeight="Bold" Foreground="white"/>
                <TextBlock Text="Ocultar o mostrar elementos, tipos o categorías en múltiples vistas." 
                           FontSize="13" Foreground="#DDDDDD" TextWrapping="Wrap"/>
            </StackPanel>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Margin="0,0,6,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <GroupBox Grid.Row="0" Grid.Column="0" Header="MODO" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="rbOcultar" Content="Ocultar" IsChecked="True" GroupName="Modo"/>
                            <RadioButton x:Name="rbMostrar" Content="Mostrar" GroupName="Modo"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Grid.Row="0" Grid.Column="1" Header="ALCANCE" Margin="6,0,0,0">
                        <StackPanel>
                            <RadioButton x:Name="rbSoloElementos" Content="Solo seleccionados" IsChecked="True" GroupName="Aplicar"/>
                            <RadioButton x:Name="rbMismoTipo" Content="Mismo tipo" GroupName="Aplicar"/>
                            <RadioButton x:Name="rbCategoria" Content="Categoría completa" GroupName="Aplicar"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Header="SELECCIÓN" Margin="0,6,0,0">
                        <StackPanel>
                            <Button Content="Seleccionar Elementos" Click="SelectElements_Click" Margin="0,0,0,4" Padding="10,4"/>
                            <TextBlock x:Name="lblSelectedCount" Text="Elementos seleccionados: 0" Foreground="#AAAAAA" FontSize="11"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Header="VISTAS DE DESTINO" Margin="0,6,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Button Content="Seleccionar todas" Click="SelectAllViews_Click" Margin="0,0,6,0" Padding="10,4"/>
                                <Button Content="Limpiar selección" Click="ClearAllViews_Click" Padding="10,4"/>
                            </StackPanel>
                            <TreeView x:Name="tvViews"/>
                        </StackPanel>
                    </GroupBox>
                    <Button Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" x:Name="btnApply" 
                            Content="APLICAR CAMBIOS" Click="ApplyChanges_Click" 
                            Height="40" FontSize="16" FontWeight="Bold" Margin="0,8,0,0" 
                            HorizontalAlignment="Stretch"/>
                </Grid>
                <Border Grid.Column="1" Width="1" Background="#404040" Margin="0,3"/>
                <Border Grid.Column="2" 
                        Background="White" 
                        CornerRadius="6" 
                        Padding="12" 
                        Margin="6,0,0,0"
                        MinWidth="200">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.30"/>
                    </Border.Effect>

                    <StackPanel>
                        <TextBlock Text="RESUMEN BIM" 
                                   FontWeight="Bold" FontSize="15" 
                                   Foreground="#111111" Margin="0,0,0,10"/>

                        <TextBlock Text="Modo:" FontWeight="SemiBold" Foreground="#333" FontSize="12"/>
                        <TextBlock x:Name="resModo" Text="Ocultar" Foreground="#666" FontSize="12" Margin="0,0,0,6"/>

                        <TextBlock Text="Alcance:" FontWeight="SemiBold" Foreground="#333" FontSize="12"/>
                        <TextBlock x:Name="resAccion" Text="Solo elementos" Foreground="#666" FontSize="12" Margin="0,0,0,6"/>

                        <TextBlock Text="Elementos:" FontWeight="SemiBold" Foreground="#333" FontSize="12"/>
                        <TextBlock x:Name="resElementos" Text="0" Foreground="#666" FontSize="12" Margin="0,0,0,6"/>

                        <TextBlock Text="Categoría:" FontWeight="SemiBold" Foreground="#333" FontSize="12"/>
                        <TextBlock x:Name="resCategorias" Text="Ninguna" Foreground="#666" FontSize="12" Margin="0,0,0,6"/>

                        <TextBlock Text="Tipo:" FontWeight="SemiBold" Foreground="#333" FontSize="12"/>
                        <TextBlock x:Name="resTipo" Text="Ninguno" Foreground="#666" FontSize="12" Margin="0,0,0,6"/>

                        <TextBlock Text="Vistas:" FontWeight="SemiBold" Foreground="#333" FontSize="12"/>
                        <TextBlock x:Name="resVistas" Text="0" Foreground="#666" FontSize="12"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- BARRA DE PROGRESO Y ESTADO -->
            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ProgressBar x:Name="progressBar" Grid.Column="0" Value="0" Minimum="0" Maximum="100"/>
                <TextBlock x:Name="lblStatus" Grid.Column="1" Text="Listo" Foreground="#AAAAAA" FontSize="11" Margin="8,0,0,0"/>
            </Grid>
        </Grid>
    </Grid>
</Window>