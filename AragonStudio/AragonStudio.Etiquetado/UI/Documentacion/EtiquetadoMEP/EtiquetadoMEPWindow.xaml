<Window x:Class="AragonStudio.UI.Documentacion.EtiquetadoMep.EtiquetadoMepWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ARAGÓN STUDIO"
        Width="1050" Height="650"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        MinWidth="900" MinHeight="580"
        Background="#1E1E1E"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.25" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ComboBoxOscuro" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="ComboBoxItemClaro" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="#F0F0F0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E0E0E0"/>
                </Trigger>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#007ACC"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="12,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#005A9E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#555555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="8,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#505050"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TreeView">
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="2"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="4" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="4" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.7*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Column="0" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,15,0">
                <TextBlock Text="ETIQUETADO MEP" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,0,0,5"/>
                <TextBlock Text="Generación de etiquetas para elementos mecánicos, eléctricos y de fontanería" FontSize="13" Foreground="#AAAAAA" Margin="0,-5,0,20"/>

                <Border Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="1. Seleccionar vistas" FontWeight="SemiBold" Foreground="#E0E0E0" FontSize="14" Margin="0,0,0,8"/>
                        <TreeView x:Name="treeVistas" MaxHeight="200" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button Content="Seleccionar todas" Width="120" Style="{StaticResource SecondaryButton}" Margin="0,0,5,0" Click="SeleccionarTodas_Click"/>
                            <Button Content="Limpiar selección" Width="120" Style="{StaticResource SecondaryButton}" Click="LimpiarSeleccion_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="2. Categoría de elementos" FontWeight="SemiBold" Foreground="#E0E0E0" FontSize="14" Margin="0,0,0,8"/>
                        <ComboBox x:Name="cmbCategorias" Style="{StaticResource ComboBoxOscuro}" SelectionChanged="cmbCategorias_SelectionChanged">
                            <ComboBox.Resources>
                                <Style TargetType="ComboBoxItem" BasedOn="{StaticResource ComboBoxItemClaro}"/>
                            </ComboBox.Resources>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="3. Tipo de etiqueta" FontWeight="SemiBold" Foreground="#E0E0E0" FontSize="14" Margin="0,0,0,8"/>
                        <TextBox x:Name="txtFiltroEtiquetas" Margin="0,0,0,8" Tag="Filtrar por nombre..." GotFocus="txtFiltroEtiquetas_GotFocus" LostFocus="txtFiltroEtiquetas_LostFocus"/>
                        <ComboBox x:Name="cmbTiposEtiqueta" Style="{StaticResource ComboBoxOscuro}" IsEnabled="False">
                            <ComboBox.Resources>
                                <Style TargetType="ComboBoxItem" BasedOn="{StaticResource ComboBoxItemClaro}"/>
                            </ComboBox.Resources>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="4. Modo de etiquetado" FontWeight="SemiBold" Foreground="#E0E0E0" FontSize="14" Margin="0,0,0,8"/>
                        <ComboBox x:Name="cmbModo" Style="{StaticResource ComboBoxOscuro}" SelectionChanged="cmbModo_SelectionChanged">
                            <ComboBox.Resources>
                                <Style TargetType="ComboBoxItem" BasedOn="{StaticResource ComboBoxItemClaro}"/>
                            </ComboBox.Resources>
                            <ComboBoxItem Content="Etiquetar todos los elementos"/>
                            <ComboBoxItem Content="Etiquetar un elemento por tipo"/>
                            <ComboBoxItem Content="Etiquetar por grupo (parámetro)"/>
                            <ComboBoxItem Content="Inteligente (tipo + tamaño)"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="5. Parámetro para agrupar (solo modo por grupo)" FontWeight="SemiBold" Foreground="#E0E0E0" FontSize="14" Margin="0,0,0,8"/>
                        <ComboBox x:Name="cmbParametros" Style="{StaticResource ComboBoxOscuro}" IsEnabled="False">
                            <ComboBox.Resources>
                                <Style TargetType="ComboBoxItem" BasedOn="{StaticResource ComboBoxItemClaro}"/>
                            </ComboBox.Resources>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="6. Opciones avanzadas" FontWeight="SemiBold" Foreground="#E0E0E0" FontSize="14" Margin="0,0,0,8"/>
                        <CheckBox x:Name="chkOpcionesAvanzadas" Content="Usar opciones avanzadas (máximo etiquetas)" IsChecked="False" Margin="0,5" Checked="ChkOpcionesAvanzadas_Checked" Unchecked="ChkOpcionesAvanzadas_Unchecked"/>
                        <Border x:Name="borderOpcionesAvanzadas" Background="#252525" CornerRadius="4" Margin="0,10,0,0" Padding="10" Visibility="Collapsed">
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Nº máximo de etiquetas" Foreground="#DDDDDD" Margin="0,0,0,5"/>
                                <TextBox x:Name="txtMaxEtiquetas" Text="1" Height="28"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="7. Línea directriz (líder)" FontWeight="SemiBold" Foreground="#E0E0E0" FontSize="14" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <RadioButton x:Name="rbConLider" Content="Con directriz" GroupName="Lider" Margin="0,0,20,0" IsChecked="True"/>
                            <RadioButton x:Name="rbSinLider" Content="Sin directriz" GroupName="Lider"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Button x:Name="btnAplicar" Content="APLICAR ETIQUETAS" Style="{StaticResource PrimaryButton}" Margin="0,10,0,5" Click="BtnAplicar_Click" IsEnabled="False"/>
                <Button x:Name="btnCancelar" Content="Cancelar" Style="{StaticResource SecondaryButton}" Width="100" HorizontalAlignment="Right" Click="BtnCancelar_Click" Visibility="Collapsed" IsEnabled="False" Margin="0,10,0,0"/>
                <ProgressBar x:Name="progressBar" Height="8" Background="#3C3C3C" Foreground="#007ACC" Value="0" Visibility="Collapsed" Margin="0,5,0,10"/>
                <TextBlock x:Name="txtResultado" FontSize="12" Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,5,0,15"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Column="1" Margin="10,0,0,0">
            <Border Background="White" CornerRadius="10" Padding="15" Margin="0,0,0,15" BorderBrush="#CCCCCC" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="IMPACTO ESTIMADO" FontWeight="Bold" FontSize="16" Foreground="#2C3E50" Margin="0,0,0,15" TextAlignment="Center"/>
                    <Grid Margin="0,5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Elementos a etiquetar:" FontWeight="Bold" Foreground="#333333" FontSize="13"/>
                        <TextBlock x:Name="txtTotalElementos" Grid.Row="0" Grid.Column="1" Text="--" Foreground="#007ACC" FontWeight="Bold" Margin="10,0,0,0" FontSize="13"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Vistas seleccionadas:" FontWeight="Bold" Foreground="#333333" FontSize="13" Margin="0,8,0,0"/>
                        <TextBlock x:Name="txtVistasSeleccionadas" Grid.Row="1" Grid.Column="1" Text="--" Foreground="#333333" Margin="10,8,0,0" FontSize="13"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Etiquetas por elemento:" FontWeight="Bold" Foreground="#333333" FontSize="13" Margin="0,8,0,0"/>
                        <TextBlock x:Name="txtEtiquetasPorElemento" Grid.Row="2" Grid.Column="1" Text="1" Foreground="#333333" Margin="10,8,0,0" FontSize="13"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>