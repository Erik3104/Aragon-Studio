<Window x:Class="AragonStudio.UI.Documentacion.EtiquetadoEstructural.EtiquetadoEstructuralWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ARAGÓN STUDIO"
        Width="1050" Height="650"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        MinWidth="900" MinHeight="580"
        Background="#1E1E1E"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.25" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComboBoxOscuro" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="ComboBoxItemClaro" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="#F0F0F0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E0E0E0"/>
                </Trigger>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#007ACC"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="12,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#005A9E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#555555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="8,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#505050"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TreeView">
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="2"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="4" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="4" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.7*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Column="0" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,15,0">
                <TextBlock Text="ETIQUETADO ESTRUCTURAL INTELIGENTE" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,0,0,5"/>
                <TextBlock Text="Motor de interpretación de intención estructural BIM" FontSize="13" Foreground="#AAAAAA" Margin="0,-5,0,20"/>

                <Border Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="1. Vistas a etiquetar" FontWeight="SemiBold" Foreground="#E0E0E0" FontSize="14" Margin="0,0,0,8"/>
                        <TreeView x:Name="treeVistas" MaxHeight="200" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button Content="Seleccionar todas" Width="110" Style="{StaticResource SecondaryButton}" Margin="0,0,5,0" Click="SeleccionarTodas_Click"/>
                            <Button Content="Limpiar" Width="80" Style="{StaticResource SecondaryButton}" Click="LimpiarSeleccion_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="2. Categoría estructural" FontWeight="SemiBold" Foreground="#E0E0E0" FontSize="14" Margin="0,0,0,8"/>
                        <ComboBox x:Name="cmbCategorias" Style="{StaticResource ComboBoxOscuro}" SelectionChanged="Categoria_SelectionChanged">
                            <ComboBox.Resources>
                                <Style TargetType="ComboBoxItem" BasedOn="{StaticResource ComboBoxItemClaro}"/>
                            </ComboBox.Resources>
                        </ComboBox>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="btnPrevisualizar" Content="Previsualizar en Revit" Width="150" Height="30" Style="{StaticResource SecondaryButton}" Margin="0,0,5,0" Click="BtnPrevisualizar_Click"/>
                            <Button x:Name="btnLimpiarSeleccionRevit" Content="Limpiar selección" Width="120" Height="30" Style="{StaticResource SecondaryButton}" Click="BtnLimpiarSeleccionRevit_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="pnlTipoEtiqueta" Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="3. Tipo de etiqueta" FontWeight="SemiBold" Foreground="#E0E0E0" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="   Línea directriz:" FontWeight="SemiBold" Foreground="#E0E0E0" Margin="25,0,5,0" VerticalAlignment="Center"/>
                            <RadioButton x:Name="rbConLider" Content="Con" GroupName="Lider" IsChecked="True" Foreground="#DDDDDD" Margin="5,0,10,0" VerticalAlignment="Center"/>
                            <RadioButton x:Name="rbSinLider" Content="Sin" GroupName="Lider" Foreground="#DDDDDD" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ComboBox x:Name="cmbTiposEtiqueta" Style="{StaticResource ComboBoxOscuro}" SelectionChanged="TipoEtiqueta_Changed" IsEnabled="False">
                            <ComboBox.Resources>
                                <Style TargetType="ComboBoxItem" BasedOn="{StaticResource ComboBoxItemClaro}"/>
                            </ComboBox.Resources>
                            <ComboBoxItem Content="Cargando..." IsEnabled="False"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="4. Modo de etiquetado" FontWeight="SemiBold" Foreground="#E0E0E0" FontSize="14" Margin="0,0,0,8"/>
                        <RadioButton x:Name="rbPorTipo" Content="Por tipo (agrupa por TypeId)" GroupName="Modo" IsChecked="True"/>
                        <RadioButton x:Name="rbPorElemento" Content="Por elemento (individual)" GroupName="Modo"/>
                        <RadioButton x:Name="rbInteligente" Content="Inteligente (agrupa armaduras similares)" GroupName="Modo" IsEnabled="False"/>

                        <StackPanel x:Name="pnlGrupos" Margin="25,10,0,0" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="lblMaxGrupos" Text="Máx. etiquetas por grupo:" FontSize="12" Foreground="#BBBBBB" VerticalAlignment="Center"/>
                                <TextBox x:Name="txtMaxGrupos" Text="2" Width="55" Margin="10,0,0,0" Background="#F0F0F0" Foreground="Black" PreviewTextInput="Numero_Validacion"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Button x:Name="btnAplicar" Content="APLICAR ETIQUETAS" Style="{StaticResource PrimaryButton}" Margin="0,10,0,5" Click="BtnAplicar_Click"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Column="1" Margin="10,0,0,0">
            <Border Background="White" CornerRadius="10" Padding="15" Margin="0,0,0,15" BorderBrush="#CCCCCC" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="IMPACTO ESTIMADO" FontWeight="Bold" FontSize="16" Foreground="#2C3E50" Margin="0,0,0,15" TextAlignment="Center"/>
                    <Grid Margin="0,5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Etiquetas totales:" FontWeight="Bold" Foreground="#333333" FontSize="13"/>
                        <TextBlock x:Name="txtTotalEtiquetas" Grid.Row="0" Grid.Column="1" Text="--" Foreground="#007ACC" FontWeight="Bold" Margin="10,0,0,0" FontSize="13"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Saturación:" FontWeight="Bold" Foreground="#333333" FontSize="13" Margin="0,8,0,0"/>
                        <TextBlock x:Name="txtSaturacion" Grid.Row="1" Grid.Column="1" Text="--" Foreground="#333333" Margin="10,8,0,0" FontSize="13"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Zonas estructurales:" FontWeight="Bold" Foreground="#333333" FontSize="13" Margin="0,8,0,0"/>
                        <TextBlock x:Name="txtZonas" Grid.Row="2" Grid.Column="1" Text="--" Foreground="#333333" Margin="10,8,0,0" FontSize="13"/>
                    </Grid>

                    <ProgressBar x:Name="progressSaturacion" Height="8" Background="#E0E0E0" Foreground="#F0AD4E" Value="0" Margin="0,10,0,0"/>

                    <TextBlock x:Name="txtAdvertencia" FontSize="12" Foreground="#D32F2F" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtResultadoEjecucion" FontSize="12" Foreground="#2C3E50" TextWrapping="Wrap" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="#2D2D2D" CornerRadius="8" Padding="10" Margin="0,0,0,0" BorderBrush="#444444" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="ℹ️ INFORMACIÓN" FontWeight="Bold" FontSize="12" Foreground="#BBBBBB" Margin="0,0,0,5"/>
                    <TextBlock Text="• Modo inteligente: agrupa barras sueltas (Rebar) por diámetro, espaciado y forma." FontSize="11" Foreground="#AAAAAA" TextWrapping="Wrap"/>
                    <TextBlock Text="• Número configurable de etiquetas por grupo." FontSize="11" Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    <TextBlock Text="• Las etiquetas se crearán en cada vista seleccionada." FontSize="11" Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>